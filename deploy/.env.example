# --- Images -----------------------------------------------------------------
# Registry + owner the Samata images are published under.
SAMATA_IMAGE_PREFIX=ghcr.io/your-org
# Pin a release in production (e.g. 0.1.0) rather than tracking `latest`.
SAMATA_VERSION=latest

# --- Public hostnames (DNS A records -> this server) -------------------------
# Caddy fetches TLS certificates for both automatically.
SAMATA_DOMAIN=samata.example.com
LIVEKIT_DOMAIN=livekit.example.com

# --- Secrets: generate each with `openssl rand -hex 32` ------------------------
POSTGRES_PASSWORD=
SAMATA_WEBHOOK_SECRET=
SAMATA_API_KEY=
LIVEKIT_API_KEY=samata
LIVEKIT_API_SECRET=

# --- Model providers ----------------------------------------------------------
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- Optional ----------------------------------------------------------------
# SAMATA_DEFAULT_AGENT=receptionist
# SAMATA_WORKER_REPLICAS=2
# SAMATA_ANALYSIS_MODEL=gpt-4.1-mini

# LiveKit Cloud instead of the bundled server: remove the livekit/sip
# services from docker-compose.yml and set
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_PUBLIC_URL=wss://<project>.livekit.cloud
