# LiveKit. Local: must match infra/livekit/livekit.yaml.
# To test phone calls from a laptop, point this at a LiveKit Cloud project
# (and the control plane at the same one): see README, "Testing phone calls".
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=samata_dev_secret_change_me_0123456789

# Control plane
SAMATA_CONTROL_PLANE_URL=http://localhost:3000
SAMATA_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Agent name the worker registers under (explicit dispatch). Must match
# SAMATA_WORKER_AGENT_NAME in the control plane and your SIP dispatch rules.
SAMATA_AGENT_NAME=samata

# Model provider keys (OpenAI, Deepgram, Cartesia, ...) are not set here. Add
# them on the dashboard's Provider Keys page; the control plane hands the right
# ones to the worker for each call.
