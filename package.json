{
  "name": "samata",
  "private": true,
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:up:sip": "docker compose -f docker-compose.yml -f docker-compose.sip.yml up -d",
    "infra:up:cloud": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "dev": "pnpm --filter control-plane dev",
    "worker:dev": "cd worker && .venv/bin/python main.py dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "pnpm --filter control-plane db:generate",
    "db:migrate": "pnpm --filter control-plane db:migrate",
    "db:studio": "pnpm --filter control-plane db:studio",
    "db:seed": "pnpm --filter control-plane db:seed",
    "db:reset": "pnpm --filter control-plane db:reset",
    "simulate:call": "pnpm --filter control-plane simulate:call",
    "site:dev": "pnpm --filter website dev",
    "site:build": "pnpm --filter website build",
    "example:webhooks": "pnpm --filter webhook-server dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11"
  }
}
