DATABASE_URL=postgres://samata:samata@localhost:5432/samata

# Shared secret the worker sends as `x-samata-secret` on every webhook.
# Must match SAMATA_WEBHOOK_SECRET in worker/.env.
SAMATA_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Local: must match infra/livekit/livekit.yaml. Used to mint browser test tokens
# and to manage SIP trunks. To test phone calls from a laptop, use a LiveKit
# Cloud project here and in worker/.env (see README, "Testing phone calls").
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=samata_dev_secret_change_me_0123456789

# Optional: post-call analysis (summary + structured data extraction). Any
# OpenAI-compatible endpoint works. Without a key, analysis is skipped.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# SAMATA_ANALYSIS_MODEL=gpt-4.1-mini

# Signs dashboard sessions. Generate with `openssl rand -hex 32`.
BETTER_AUTH_SECRET=dev-auth-secret-change-me-0123456789abcdef
# Public URL of the dashboard. Used for invitation links and sign-in cookies.
# Leave unset in dev (the request's own origin is used).
# BETTER_AUTH_URL=https://samata.example.com
# Optional "Continue with Google" on the sign-in page.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Bearer key for the management API (/api/agents, /api/calls). Acts on the
# default workspace.
SAMATA_API_KEY=dev-api-key-change-me
# Agent (id or slug) for calls that match nothing else.
# SAMATA_DEFAULT_AGENT=receptionist

# --- Phone numbers (Phone Numbers page) ---------------------------------------
# Public address of your LiveKit SIP server (docker compose `sip`, port 5060):
# a hostname, `host:port`, or IPv4. Telnyx is pointed here when you import a
# number, so it must be reachable from the internet. Unset = numbers import but
# can't be connected.
# SAMATA_SIP_HOST=sip.example.com
# Only accept SIP calls from these IPs/CIDRs (comma separated). Defaults to
# Telnyx's published signaling addresses.
# SAMATA_SIP_ALLOWED_ADDRESSES=
# Encrypts provider API keys stored for imported numbers. Defaults to
# BETTER_AUTH_SECRET.
# SAMATA_ENCRYPTION_KEY=
