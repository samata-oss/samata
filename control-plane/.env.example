DATABASE_URL=postgres://samata:samata@localhost:5432/samata
REDIS_URL=redis://localhost:6379

# Shared secret the worker sends as `x-samata-secret` on every webhook.
# Must match SAMATA_WEBHOOK_SECRET in worker/.env.
SAMATA_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Must match infra/livekit/livekit.yaml. Used to mint browser test tokens.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=samata_dev_secret_change_me_0123456789

# Optional: post-call analysis (summary + structured data extraction). Any
# OpenAI-compatible endpoint works. Without a key, analysis is skipped.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# SAMATA_ANALYSIS_MODEL=gpt-4.1-mini

# Bearer key for the management API (/api/agents, /api/calls).
SAMATA_API_KEY=dev-api-key-change-me
# Agent (id or slug) for calls that match nothing else.
# SAMATA_DEFAULT_AGENT=receptionist
