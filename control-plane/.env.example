DATABASE_URL=postgres://samata:samata@localhost:5432/samata

# Shared secret the worker sends as `x-samata-secret` on every webhook.
# Must match SAMATA_WEBHOOK_SECRET in worker/.env.
SAMATA_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Local: must match infra/livekit/livekit.yaml. Used to mint browser test tokens
# and to manage SIP trunks. To test phone calls from a laptop, use a LiveKit
# Cloud project here and in worker/.env (see README, "Testing phone calls").
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=samata_dev_secret_change_me_0123456789

# Model provider keys (OpenAI, Deepgram, Cartesia, OpenRouter, ...) are added
# per workspace on the dashboard's Provider Keys page, not here. Post-call
# analysis uses each assistant's own model provider and key.
# Optional: model for post-call analysis. Defaults to the provider's small
# default model (e.g. gpt-4.1-mini); an assistant's analysis plan can override it.
# SAMATA_ANALYSIS_MODEL=gpt-4.1-mini

# Signs dashboard sessions. Generate with `openssl rand -hex 32`.
BETTER_AUTH_SECRET=dev-auth-secret-change-me-0123456789abcdef
# Public URL of the dashboard. Used for invitation links and sign-in cookies.
# Leave unset in dev (the request's own origin is used).
# BETTER_AUTH_URL=https://samata.example.com
# Optional "Continue with Google" on the sign-in page.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Bearer key for the management API (/api/agents, /api/calls). Acts on the
# default workspace.
SAMATA_API_KEY=dev-api-key-change-me
# Agent (id or slug) for calls that match nothing else.
# SAMATA_DEFAULT_AGENT=receptionist

# --- Email (optional) ---------------------------------------------------------
# Emails invitations and password-reset links through Resend (resend.com), and
# on the managed cloud the confirmation link new accounts must open. Without
# these the message is logged to the server console instead.
# RESEND_API_KEY=re_...
# From address, on a domain verified in Resend.
# SAMATA_EMAIL_FROM=Samata <noreply@example.com>

# --- Phone numbers (Phone Numbers page) ---------------------------------------
# Public address of your LiveKit SIP server (docker compose `sip`, port 5060):
# a hostname, `host:port`, or IPv4. Telnyx is pointed here when you import a
# number, so it must be reachable from the internet. Unset = numbers import but
# can't be connected.
# SAMATA_SIP_HOST=sip.example.com
# Only accept SIP calls from these IPs/CIDRs (comma separated). Defaults to
# Telnyx's published signaling addresses.
# SAMATA_SIP_ALLOWED_ADDRESSES=
# Encrypts the provider keys stored in the dashboard (model providers and
# imported phone numbers). Defaults to BETTER_AUTH_SECRET. Changing either
# makes stored keys unreadable: re-enter them.
# SAMATA_ENCRYPTION_KEY=

# --- Managed cloud (billing) --------------------------------------------------
# Only for the hosted Samata Cloud. Leave unset when self-hosting: with it off
# there is no Billing page, no Stripe code runs, and calls are never limited.
# SAMATA_CLOUD=1
# On the cloud anyone can sign up (after confirming their email, so Resend
# above is required in production) and gets their own workspace. Leave
# SAMATA_API_KEY and SAMATA_DEFAULT_AGENT unset above: they act on the shared
# default workspace.
# Concurrent calls a workspace may run for free (default 5). Past that it needs
# the flat plan; subscribed workspaces have no limit.
# SAMATA_FREE_CONCURRENT_CALLS=5
# Stripe secret key, and the signing secret of a webhook endpoint pointed at
# <your-url>/api/billing/webhook (events: customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# The flat recurring price (e.g. $20/month) a workspace subscribes to.
# SAMATA_STRIPE_PRICE_ID=price_...
