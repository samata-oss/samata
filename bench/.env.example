# LiveKit project that owns the outbound SIP trunk. For real phone calls from a
# laptop, use a LiveKit Cloud project (or a self-hosted one with SIP reachable
# by your carrier).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Only for `gen-utterances`.
OPENAI_API_KEY=

# `serve` mode (jobs queued from the dashboard's Benchmarks page). Same
# shared secret the worker uses.
SAMATA_CONTROL_PLANE_URL=http://localhost:3000
SAMATA_WEBHOOK_SECRET=
# Outbound SIP trunk id (from `setup-trunk`). Overrides trunk_id in bench.toml.
SAMATA_BENCH_TRUNK_ID=
# Optional safety net: only dial these numbers (comma-separated E.164), even if
# someone queues a run for others from the dashboard.
SAMATA_BENCH_ALLOWED_NUMBERS=
